{
  "manifest_version": 3,
  "name": "SAT Question Bank Exporter",
  "version": "0.4.2",
  "description": "Helps you save and organize your own practice questions from your authenticated session into local PDFs and practice files.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "debugger",
    "downloads",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "https://mypractice.collegeboard.org/*",
    "https://digitalpractice-api.collegeboard.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SAT Question Bank Exporter"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mypractice.collegeboard.org/questionbank/*",
        "https://mypractice.collegeboard.org/details*",
        "https://mypractice.collegeboard.org/dashboard*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
